{
  "name": "coastlink-portal",
  "version": "0.1.0",
  "description": "CoastLink Council facility booking and maintenance portal (prototype)",
  "main": "src/server/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "node src/server/index.js",
    "start": "npm run build && node src/server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.22.2",
    "nsw-design-system": "^3.27.0"
  },
  "devDependencies": {
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
